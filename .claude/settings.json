{
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/scripts/unity-compile-check.sh\"",
            "timeout": 120,
            "statusMessage": "Compiling Unity scripts..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/scripts/unity-meta-guard.sh\"",
            "timeout": 30,
            "statusMessage": "Checking .meta files..."
          }
        ]
      }
    ]
  }
}
